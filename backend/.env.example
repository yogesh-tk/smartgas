# ====================================================================
# Bharat Scheme - Smart Gas Management Module (MERN Stack)
# Environment Configuration
# ====================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Secret
JWT_SECRET=bharat_gas_portal_super_secure_jwt_secret_key_2026

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/bharat_gas_db

# Brevo transactional email (email verification and notifications)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bharat Scheme

# Google Gemini API (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Cloud Messaging (FCM) Configuration
FIREBASE_PROJECT_ID=bharat-gas-scheme
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LPG Provider Gateway Mode: 'mock' (National Sandbox Grid) or 'official'
LPG_API_MODE=mock
LPG_DEMO_GRID_NOTICE="Simulated National LPG Grid Sandbox Data - Bharat Scheme"
